# --- Deployment ------------------------------------------------------------
# Public origin of this deployment. The Google redirect URI is derived from it, so it must
# match the one registered in Google Cloud exactly (no trailing slash).
APP_URL=https://ax-research-production.up.railway.app

# Signs session cookies AND derives the key that encrypts users' stored API keys.
# Generate with: openssl rand -base64 48
# Rotating it logs everyone out and makes every stored user API key undecryptable.
JWT_SECRET=

# Provided by the Railway MySQL plugin.
DATABASE_URL=

# --- Google sign-in --------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI must be exactly: <APP_URL>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in. Empty means any Google account may sign in.
# Keep it set while the deployment holds only your own research notes.
ALLOWED_EMAILS=

# The account with this email becomes admin on first sign-in.
OWNER_EMAIL=

# --- Muse Spark (operator model) -------------------------------------------
# Carries every call that does NOT arrive with a user's own key, so this is what the app
# runs on by default. Charged to you, and counted against that user's monthly quota.
#
# Meta's API is OpenAI-compatible, as are the other gateways that serve the same models
# (llm-stats, aimlapi, EmpirioLabs) — switching is a URL change, not a code change.
MUSE_SPARK_API_KEY=
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1

# Pinned on purpose: a run records its model next to promptVersion, so letting the catalog
# pick made past runs irreproducible. Must be a model this key can actually call —
# `pnpm models` prints the catalog. As of 2026-09: muse-spark-1.3 / 1.2 / 1.1.
INFERENCE_MODEL=muse-spark-1.3

# --- Gemini (BYOK fallback only) -------------------------------------------
# Users who register their own key in settings register a *Gemini* key, so those calls
# keep going to Gemini and are billed to them. Leaving this empty is normal: it is only
# the operator's fallback for the Gemini path, which nothing uses by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Object storage (Cloudflare R2) ----------------------------------------
# dash.cloudflare.com -> R2 -> Manage R2 API Tokens (Object Read & Write).
# Keep the bucket private; notes are served through short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- External research APIs ------------------------------------------------
# OpenAlex routes identified requests to the polite pool (measured 1.9s -> 0.4s).
OPENALEX_MAILTO=

# --- Tests -----------------------------------------------------------------
# RUN_DB_TESTS=1 with a throwaway DATABASE_URL runs the isolation, staleness and quota
# suites. RUN_LIVE_API=1 runs the live OpenAlex seed sample.
#
# Throwaway MySQL 8. MySQL 5.7 cannot run these migrations: they use `DEFAULT (now())`,
# which needs 8.0.13 or newer.
#
#   docker run --name ax-mysql -e MYSQL_ROOT_PASSWORD=devpw -e MYSQL_DATABASE=ax \
#     -p 13306:3306 -d mysql:8
#   export DATABASE_URL="mysql://root:devpw@127.0.0.1:13306/ax"
#   npx drizzle-kit migrate          # builds every migration from empty
#   RUN_DB_TESTS=1 JWT_SECRET=test-secret-for-encryption-round-trip pnpm test
#   docker rm -f ax-mysql
#
# Rebuilding from empty is the check that matters: migrations 0002 and 0003 were both
# unrunnable on a fresh database until 2026-09-03, which means no database had ever been
# built from this history. Re-run the sequence above after touching drizzle/.
